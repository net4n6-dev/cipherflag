# CipherFlag Docker Compose environment. These configure the containers;
# CipherFlag itself is configured in config/cipherflag.toml and Settings
# (Venafi included).

# Interface the Zeek sensor (docker compose --profile zeek) captures on,
# e.g. eth0. Live capture needs a Linux host. Leave empty to only process
# PCAP files.
NETWORK_INTERFACE=

# Host directory the Zeek sensor takes PCAP files from, one subdirectory
# per job: <dir>/<job>/capture.pcap
ZEEK_PCAP_DIR=./pcap-input

# PostgreSQL password. If you change it, change the password in
# [storage] postgres_url in config/cipherflag.toml to match.
POSTGRES_PASSWORD=changeme
